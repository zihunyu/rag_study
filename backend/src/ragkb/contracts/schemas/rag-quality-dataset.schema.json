{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business-owned RAG quality gold dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "revision", "owner", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "question", "expected_answer", "relevant_document_ids", "relevant_chunk_ids", "answerable", "tenant_id", "security_scope", "query_type", "difficulty"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "expected_answer": {"type": "string"},
          "relevant_document_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "relevant_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "answerable": {"type": "boolean"},
          "tenant_id": {"type": "string", "minLength": 1},
          "security_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "query_type": {"enum": ["identifier", "keyword", "semantic", "multihop", "temporal", "negative", "unanswerable", "permission"]},
          "difficulty": {"enum": ["easy", "medium", "hard"]}
        }
      }
    }
  }
}
