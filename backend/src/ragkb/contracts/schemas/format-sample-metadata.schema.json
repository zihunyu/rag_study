{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G4 real format sample metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "real_gate", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "format": {
      "enum": ["pdf_text", "pdf_scanned_or_image", "docx", "pptx", "spreadsheet", "audio"]
    },
    "real_gate": {"const": "G4"},
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "file", "real_sample", "sha256", "deidentified",
          "authorization_ref", "rights_confirmed", "source_classification",
          "expected_locators"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "real_sample": {"const": true},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "deidentified": {"const": true},
          "authorization_ref": {"type": "string", "minLength": 1},
          "rights_confirmed": {"const": true},
          "source_classification": {
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "expected_locators": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object", "minProperties": 1}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
