# 自建 Milvus 专用覆盖文件：复制为 config/.env.milvus，并填写实际连接值。
# 在主配置 config/.env 设置 VECTOR_BACKEND=milvus 才读取此文件。
# 仅允许 VECTOR_* 连接/索引参数，不在这里重复设置 VECTOR_BACKEND。
# 优先级：进程环境 > 此文件 > config/.env > 类型默认值。
# standalone 是 Docker 服务名；Windows 主机连接已映射端口时使用 127.0.0.1:19530。
VECTOR_URI=standalone:19530
VECTOR_DATABASE=default
VECTOR_COLLECTION=rag_chunks
VECTOR_USER=root
VECTOR_PASSWORD=<your_password>
# 若用 token，清空 VECTOR_USER/VECTOR_PASSWORD，填写 VECTOR_TOKEN。
VECTOR_TOKEN=
VECTOR_DIMENSION=1024
VECTOR_METRIC_TYPE=COSINE
VECTOR_ENABLE_BM25=true
VECTOR_BM25_ANALYZER=chinese
VECTOR_DENSE_FIELD=dense_vector
VECTOR_SPARSE_FIELD=sparse_vector
VECTOR_TIMEOUT_SECONDS=30
VECTOR_CONSISTENCY_LEVEL=Bounded
VECTOR_SECURITY_CONSISTENCY_LEVEL=Strong
