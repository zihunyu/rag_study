# ==================== 应用基础配置 ====================
# 应用显示名称，用于日志、页面标题和运行状态输出。
APP_NAME=Enterprise RAG Knowledge Base
# 运行环境，可选 development、testing、production。
APP_ENV=development
# RAG 依赖装配；local 仅使用本地适配器，production 禁止 Deterministic/Fake 组件。
RAG_RUNTIME_PROFILE=local
# 真实端到端评测生成的哈希证据；不存在或不匹配时 real_acceptance 保持 false。
RAG_ACCEPTANCE_EVIDENCE_PATH=./artifacts/acceptance/real-rag.json
# 由受保护 CI Environment 持有的验收 HMAC 密钥；本地留空。
RAG_ACCEPTANCE_SIGNING_KEY=
# 验收证据最长有效期，默认七天。
RAG_ACCEPTANCE_MAX_AGE_HOURS=168
# 防止三条 Starter 或缺少关键查询类型的数据集被签成真实验收。
RAG_ACCEPTANCE_MIN_CASES=10
RAG_ACCEPTANCE_REQUIRED_QUERY_TYPES=identifier,keyword,semantic,multihop,temporal,negative,unanswerable,permission
REAL_ACCEPTANCE_MAX_PROVIDER_CALLS=60
REAL_ACCEPTANCE_MAX_INPUT_TOKENS=200000
REAL_ACCEPTANCE_MAX_OUTPUT_TOKENS=20000
# Provider 官方价格；正常运行可以保持 0，此时不计算价格且 real_acceptance 保持 false。
# 只有执行并签署低成本真实验收报告时，才需要填写服务商实际人民币/百万 Token 单价。
EMBEDDING_INPUT_COST_PER_MILLION_CNY=0
RERANKER_INPUT_COST_PER_MILLION_CNY=0
LLM_INPUT_COST_PER_MILLION_CNY=0
LLM_OUTPUT_COST_PER_MILLION_CNY=0
VERIFIER_INPUT_COST_PER_MILLION_CNY=0
VERIFIER_OUTPUT_COST_PER_MILLION_CNY=0
# 部署负责人显式开启后，production profile 才能发起真实模型请求。
REAL_PROVIDER_CALLS_ENABLED=false
# 生产发布/撤权/删除同步修改 MySQL、Redis 与向量投影时必须显式开启。
EXTERNAL_LIFECYCLE_MUTATIONS_ENABLED=false
# 后端监听地址；本机开发建议只监听 127.0.0.1。
APP_HOST=127.0.0.1
# 后端 HTTP 端口。
APP_PORT=8000
# 前端 npm run dev 的监听地址。
FRONTEND_HOST=127.0.0.1
# 前端 npm run dev 的端口。
FRONTEND_PORT=5173
# 项目时区，用于展示时间；数据库仍统一保存 UTC。
APP_TIMEZONE=Asia/Hong_Kong
# 是否开启调试模式；生产环境必须为 false。
APP_DEBUG=true
# 应用签名密钥，用于会话、临时下载令牌等签名；请替换为随机长字符串。
APP_SECRET_KEY=change_me_to_a_long_random_secret
# JSON Secret keyring；active kid 用于新签名，retiring key 仅用于验证历史链接。
REFERENCE_ACTIVE_KID=v1
REFERENCE_SIGNING_KEYRING=
# 部署的 40 位 Git Commit SHA；production 验收证据必须绑定此版本。
APP_REVISION=
# 本地文件存储只允许单实例 Production；不得配置为 multi_instance。
DEPLOYMENT_TOPOLOGY=single_instance
# 允许访问后端的前端来源，多个地址用英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5173

# ==================== 本地文件存储 ====================
# 本地内容存储根目录；原件、解析产物、隔离文件均放在该目录下。
LOCAL_STORAGE_ROOT=./data/storage
# 原始上传文件保存目录。
LOCAL_STORAGE_ORIGINAL_DIR=./data/storage/original
# 解析结果、规范化文档、图片等产物目录。
LOCAL_STORAGE_ARTIFACTS_DIR=./data/storage/artifacts
# 未完成安全校验的上传文件隔离目录。
LOCAL_STORAGE_QUARANTINE_DIR=./data/storage/quarantine
# 任务临时文件目录，任务结束后按策略清理。
LOCAL_STORAGE_TEMP_DIR=./data/storage/temp
# 本地审计日志和哈希链归档目录。
LOCAL_STORAGE_AUDIT_DIR=./data/storage/audit
# 本地备份目录；建议指向另一块物理磁盘。
LOCAL_STORAGE_BACKUP_DIR=./data/storage/backups
# 本地存储最大容量，单位 GB；超过后停止接收新上传。
LOCAL_STORAGE_MAX_GB=100
# Readiness fails below this amount of free space; no external probe is performed.
LOCAL_STORAGE_MIN_FREE_GB=1
# 文件完整性校验算法，当前固定使用 sha256。
LOCAL_STORAGE_CHECKSUM_ALGORITHM=sha256

# ==================== MySQL 配置 ====================
# MySQL 服务器地址。
MYSQL_HOST=127.0.0.1
# MySQL 服务端口。
MYSQL_PORT=3306
# MySQL 数据库名称。
MYSQL_DATABASE=rag_kb
# MySQL 登录用户名。
MYSQL_USER=rag_app
# MySQL 登录密码；请勿提交真实值。
MYSQL_PASSWORD=change_me
# MySQL 字符集，必须支持完整 Unicode。
MYSQL_CHARSET=utf8mb4
# MySQL 是否启用 TLS；本机开发可 false，远程连接建议 true。
MYSQL_SSL=false
# 数据库连接池常驻连接数。
MYSQL_POOL_SIZE=10
# 数据库连接池允许临时增加的连接数。
MYSQL_MAX_OVERFLOW=20
# 建立数据库连接的超时时间，单位秒。
MYSQL_CONNECT_TIMEOUT_SECONDS=10

# ==================== Redis 配置 ====================
# Redis 服务器地址，用于缓存、限流和短期状态；不保存唯一业务数据。
REDIS_HOST=127.0.0.1
# Redis 服务端口。
REDIS_PORT=6379
# Redis 登录用户名；未启用 ACL 时留空。
REDIS_USER=
# Redis 登录密码；未设置密码时留空。
REDIS_PASSWORD=
# Redis Database 编号。
REDIS_DB=0
# Redis 是否启用 TLS。
REDIS_SSL=false
# Redis 键前缀，避免与其他项目冲突。
REDIS_KEY_PREFIX=ragkb:
# Redis 连接和读写超时时间，单位秒。
REDIS_TIMEOUT_SECONDS=5

# ==================== Zilliz Cloud 中国区配置 ====================
# Zilliz Cloud 集群 Endpoint，从 cloud.zilliz.com.cn 控制台“连接”卡片复制。
ZILLIZ_CLOUD_URI=https://your-cluster-id.your-region.vectordb.zilliz.com.cn:19530
# Zilliz Cloud API Key 或 username:password 集群凭据；请勿提交真实值。
ZILLIZ_CLOUD_TOKEN=change_me
# Zilliz Cloud 数据库名称；未创建其他数据库时使用 default。
ZILLIZ_CLOUD_DATABASE=default
# 存放 Chunk 向量和 BM25 字段的 Collection 名称。
ZILLIZ_CLOUD_COLLECTION=rag_chunks
# Zilliz Cloud 请求超时时间，单位秒。
ZILLIZ_CLOUD_TIMEOUT_SECONDS=30
# 普通检索一致性级别，可选 Strong、Session、Bounded、Eventually。
ZILLIZ_CLOUD_CONSISTENCY_LEVEL=Bounded
# 权限收紧、撤权和发布验证时使用的一致性级别，必须保持 Strong。
ZILLIZ_CLOUD_SECURITY_CONSISTENCY_LEVEL=Strong
# Dense 向量距离类型，必须与 Embedding 归一化方式一致。
ZILLIZ_CLOUD_METRIC_TYPE=COSINE
# Dense 向量维度，必须与 EMBEDDING_DIMENSION 相同。
ZILLIZ_CLOUD_DIMENSION=1024
# 是否启用 Zilliz/Milvus 原生 BM25 稀疏检索。
ZILLIZ_CLOUD_ENABLE_BM25=true
# BM25 中文分析器名称。
ZILLIZ_CLOUD_BM25_ANALYZER=chinese
# Dense 向量字段名称。
ZILLIZ_CLOUD_DENSE_FIELD=dense_vector
# BM25 稀疏向量字段名称。
ZILLIZ_CLOUD_SPARSE_FIELD=sparse_vector
# 单次写入最多记录数、请求体字节数，以及瞬时失败重试次数。
ZILLIZ_WRITE_BATCH_SIZE=256
ZILLIZ_WRITE_MAX_BYTES=4194304
ZILLIZ_WRITE_MAX_RETRIES=3

# ==================== 可替换向量后端 ====================
# local、zilliz 或自托管 milvus；zilliz 继续兼容上方历史配置。
VECTOR_BACKEND=zilliz
VECTOR_URI=
VECTOR_TOKEN=
VECTOR_DATABASE=default
VECTOR_COLLECTION=rag_chunks
VECTOR_DIMENSION=1024
VECTOR_METRIC_TYPE=COSINE
VECTOR_ENABLE_BM25=true
VECTOR_BM25_ANALYZER=chinese
VECTOR_DENSE_FIELD=dense_vector
VECTOR_SPARSE_FIELD=sparse_vector
VECTOR_TIMEOUT_SECONDS=30
VECTOR_CONSISTENCY_LEVEL=Bounded
VECTOR_SECURITY_CONSISTENCY_LEVEL=Strong

# ==================== Python 本地持久队列 ====================
# 本地任务队列 SQLite 文件路径；这是唯一队列实现。
QUEUE_DATABASE_PATH=./data/storage/queue/jobs.sqlite3
# Worker 无任务时的轮询间隔，单位秒。
QUEUE_POLL_INTERVAL_SECONDS=1
# Worker 领取任务后的租约时间，单位秒。
QUEUE_LEASE_SECONDS=60
# Worker 心跳间隔，单位秒，必须小于租约时间。
QUEUE_HEARTBEAT_SECONDS=15
# 单个任务最大自动重试次数。
QUEUE_MAX_RETRIES=3
# 任务重试的基础等待时间，单位秒。
QUEUE_RETRY_DELAY_SECONDS=5
# Worker 暂时性错误指数退避上限和随机抖动秒数。
WORKER_RETRY_MAX_DELAY_SECONDS=300
WORKER_RETRY_JITTER_SECONDS=1
# 暂时性依赖错误最多尝试次数（同时受 Job max_attempts 限制）。
WORKER_TRANSIENT_MAX_ATTEMPTS=5
# 连续依赖失败达到阈值后暂停租约获取，并进入冷却。
WORKER_DEPENDENCY_FAILURE_THRESHOLD=3
WORKER_DEPENDENCY_COOLDOWN_SECONDS=30
# 永久错误、未知错误或控制路径失败后的最小循环暂停。
WORKER_FAILURE_PAUSE_SECONDS=1

# ==================== MinerU 多账号配置 ====================
# MinerU API 地址；使用中国区托管接口或你的自建接口。
MINERU_BASE_URL=https://mineru.net/api/v4
# 多个 MinerU 账号 Token，使用英文逗号分隔；程序按轮询策略选取。
MINERU_TOKENS=token_account_1,token_account_2
# Token 选择策略；当前要求 round_robin。
MINERU_TOKEN_STRATEGY=round_robin
# 单个 Token 连续失败多少次后进入冷却。
MINERU_TOKEN_MAX_FAILURES=3
# Token 失败或限流后的冷却时间，单位秒；冷却期间跳过该 Token。
MINERU_TOKEN_COOLDOWN_SECONDS=60
# 每个 Token 允许的最大并发请求数。
MINERU_MAX_CONCURRENCY_PER_TOKEN=1
# MinerU 单次请求超时时间，单位秒。
MINERU_TIMEOUT_SECONDS=300
# MinerU 模型版本，例如 vlm 或 pipeline；以账号实际支持为准。
MINERU_MODEL_VERSION=vlm
# 是否启用 OCR。
MINERU_ENABLE_OCR=true
# 是否启用表格识别。
MINERU_ENABLE_TABLE=true
# 是否启用公式识别。
MINERU_ENABLE_FORMULA=true
# 是否在某个 Token 失败后自动切换到下一个可用 Token。
MINERU_FAILOVER_ENABLED=true
# 生产 Parser 的持久化总预算和单文件轮询边界。
MINERU_RUNTIME_MAX_FILES=100000
MINERU_RUNTIME_MAX_REQUESTS=3300000
MINERU_RUNTIME_MAX_POLLS_PER_FILE=60
MINERU_RUNTIME_POLL_INTERVAL_SECONDS=2

# ==================== LLM 配置 ====================
# OpenAI-compatible LLM Base URL；支持 HTTP 或 HTTPS。
LLM_BASE_URL=https://your-llm-provider.example.com/v1
# 地址为 HTTP 时必须显式设为 true；HTTPS 建议保持 false。该开关在 Production 同样生效。
LLM_ALLOW_HTTP=false
# LLM API Key。
LLM_API_KEY=change_me
# LLM 精确模型 ID。
LLM_MODEL=change_me
# LLM 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=120
# LLM 最大并发请求数。
LLM_MAX_CONCURRENCY=8
# 单次答案允许生成的最大 Token 数。
LLM_MAX_OUTPUT_TOKENS=2048
# 生成采样参数与可审计 Prompt 版本。
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_PROMPT_REVISION=grounded-qa:v1
# 仅缓存已通过引用与权限复核的答案。
LLM_GENERATION_CACHE_TTL_SECONDS=3600
# 回答允许出现的 URL 域名；留空时所有外部 URL 均拒绝。
LLM_ALLOWED_OUTPUT_DOMAINS=
# 独立声明核验模型；Production 必须配置且不得与 LLM_MODEL 相同。
# BASE_URL 填核验模型的 OpenAI-compatible /v1 地址，API_KEY 填该服务真实密钥，MODEL 填服务商模型 ID。
VERIFIER_BASE_URL=
VERIFIER_API_KEY=
VERIFIER_MODEL=
VERIFIER_TIMEOUT_SECONDS=30
VERIFIER_MAX_CONCURRENCY=4
# 所有模型请求共享的连接池、重试与熔断参数。
MODEL_HTTP_CONNECT_TIMEOUT_SECONDS=10
MODEL_HTTP_POOL_TIMEOUT_SECONDS=10
MODEL_HTTP_MAX_CONNECTIONS=100
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
MODEL_HTTP_MAX_RETRIES=3
MODEL_HTTP_BACKOFF_SECONDS=0.25
MODEL_HTTP_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_HTTP_CIRCUIT_COOLDOWN_SECONDS=30

# ==================== Embedding 配置 ====================
# OpenAI-compatible Embedding Base URL。
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com/v1
# Embedding API Key。
EMBEDDING_API_KEY=change_me
# Embedding 精确模型 ID。
EMBEDDING_MODEL=change_me
# Embedding 向量维度，必须与 ZILLIZ_CLOUD_DIMENSION 一致。
EMBEDDING_DIMENSION=1024
# 是否对 Embedding 向量做归一化。
EMBEDDING_NORMALIZE=true
# Embedding 批处理大小。
# DashScope text-embedding-v4 accepts at most 10 texts per request.
EMBEDDING_BATCH_SIZE=10
# Embedding 最大并发请求数。
EMBEDDING_MAX_CONCURRENCY=4

# ==================== Reranker 配置 ====================
# OpenAI-compatible Reranker Base URL。
RERANKER_BASE_URL=https://your-reranker-provider.example.com/v1
# Reranker API Key。
RERANKER_API_KEY=change_me
# Reranker 精确模型 ID。
RERANKER_MODEL=change_me
# Reranker 单次最多处理的候选数量。
RERANKER_MAX_CANDIDATES=40
# Reranker 独立并发上限。
RERANKER_MAX_CONCURRENCY=4
# Reranker 请求超时时间，单位秒。
RERANKER_TIMEOUT_SECONDS=60

# ==================== ASR 音频转写配置 ====================
# 是否启用 ASR。默认 false 表示当前范围暂缓音频识别；未来恢复时改为 true，并填写下列三项。
ASR_ENABLED=false
# ASR 服务 Base URL；仅 ASR_ENABLED=true 时必填。
ASR_BASE_URL=https://your-asr-provider.example.com/v1
# ASR API Key；仅 ASR_ENABLED=true 时必填。
ASR_API_KEY=change_me
# ASR 精确模型 ID；仅 ASR_ENABLED=true 时必填。
ASR_MODEL=change_me
# ASR 默认语言，auto 表示自动识别。
ASR_LANGUAGE=auto
# ASR 请求超时时间，单位秒。
ASR_TIMEOUT_SECONDS=600

# ==================== 检索与 Chunk 配置 ====================
# token、structure 或 semantic；默认保留标题/章节边界。
CHUNK_STRATEGY=structure
# 普通正文目标 Chunk 长度，单位 Token。
CHUNK_TARGET_TOKENS=600
# 相邻 Chunk 重叠长度，单位 Token。
CHUNK_OVERLAP_TOKENS=80
# 过短尾块合并阈值及硬上限。
CHUNK_MIN_TOKENS=20
CHUNK_MAX_TOKENS=800
# Semantic 策略相邻节点余弦相似度低于该值时切分。
CHUNK_SEMANTIC_THRESHOLD=0.45
# 父 Chunk 最大长度，单位 Token。
PARENT_CHUNK_MAX_TOKENS=1200
# Production 必须绑定与 EMBEDDING_MODEL 匹配的正式 tokenizer.json。
# PATH 是本机文件路径；SHA256 可用 Get-FileHash 计算；ID 填模型名和 tokenizer 版本，例如 vendor-model-v1。
TOKENIZER_ARTIFACT_PATH=./config/tokenizer.json
TOKENIZER_ARTIFACT_SHA256=
TOKENIZER_ID=
# BM25 单路召回数量。
RETRIEVAL_BM25_TOP_K=50
# 当前可查询的不可变索引代际；必须填写 MySQL/Zilliz 已完成索引和 checksum 对账的 generation ID。
RETRIEVAL_ACTIVE_GENERATION_ID=local-g3-generation
# Dense 向量单路召回数量。
RETRIEVAL_DENSE_TOP_K=50
# RRF 融合常数。
RETRIEVAL_RRF_K=60
# 默认通道权重；型号、错误码等精确查询单独提高 BM25 权重。
RETRIEVAL_BM25_WEIGHT=1
RETRIEVAL_DENSE_WEIGHT=1
RETRIEVAL_IDENTIFIER_BM25_WEIGHT=2
# 送入 Reranker 的候选数量。
RETRIEVAL_RERANK_TOP_K=40
# 最终送入 LLM 的最大证据片段数量。
RETRIEVAL_FINAL_EVIDENCE_COUNT=8
# 近重复 Jaccard 阈值与单文档最大证据片段数。
RETRIEVAL_NEAR_DUPLICATE_THRESHOLD=0.92
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
# 同一章节进入最终候选的最大 Chunk 数。
RETRIEVAL_MAX_CHUNKS_PER_SECTION=2

# ==================== 上传与安全配置 ====================
# 单文件最大上传大小，单位 MB。
UPLOAD_MAX_FILE_SIZE_MB=200
# 隔离区总容量上限；包括已完成但尚未提升的上传，单位 GB。
UPLOAD_QUARANTINE_MAX_GB=5
# 同一进程允许并行写入隔离区的上传流数量；其余请求等待形成背压。
UPLOAD_MAX_CONCURRENT_STREAMS=4
# OOXML/ZIP 全部条目的累计解压字节硬上限（包含嵌套包）。
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
# 单个压缩条目的解压字节硬上限。
UPLOAD_MAX_ARCHIVE_ENTRY_UNCOMPRESSED_BYTES=268435456
# 外层 OOXML 为深度 0；默认最多允许一层嵌套压缩包。
UPLOAD_MAX_ARCHIVE_NESTING_DEPTH=1
# 压缩包校验在独立子进程中的墙钟超时秒数。
UPLOAD_ARCHIVE_VALIDATION_TIMEOUT_SECONDS=10
# 单文档最大页数。
UPLOAD_MAX_PAGES=600
# 允许上传的扩展名，使用英文逗号分隔。
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,ppt,pptx,md,txt,html,xls,xlsx,csv,wav,mp3,m4a
# 恶意文件扫描程序；Windows 本机默认使用 Windows Defender。
MALWARE_SCANNER=windows_defender
# 是否允许把 public、internal、confidential 数据发送到已批准的外部 AI 服务。
AI_OUTBOUND_ALLOWED=true
# 允许发送到外部 AI 的数据分级，使用英文逗号分隔；禁止包含 restricted。
AI_OUTBOUND_ALLOWED_CLASSIFICATIONS=public,internal,confidential
# 已批准的 AI 供应商数据处理区域，使用英文逗号分隔。
AI_APPROVED_PROCESSING_REGIONS=
# 是否允许跨境传输数据。
AI_CROSS_BORDER_TRANSFER_ALLOWED=false
# 允许使用已审核内网/VPN 加密例外的外部 AI 服务名，英文逗号分隔；默认留空。
AI_TRUSTED_PRIVATE_TRANSPORT_SERVICES=
# 受信任内网/VPN 加密例外的审批证据编号或可审计说明；无例外时留空。
AI_TRUSTED_PRIVATE_TRANSPORT_EVIDENCE=

# ==================== 身份与权限配置 ====================
# 身份模式；local_single_user 用于本机开发，oidc 用于多人环境。
AUTH_MODE=local_single_user
# 本地单用户模式的默认租户编码。
AUTH_LOCAL_TENANT=local
# 本地单用户模式的默认用户 ID。
AUTH_LOCAL_USER_ID=local-admin
# OIDC Issuer URL；填身份平台 Discovery 文档对应的 issuer，例如 https://id.example.com/realms/rag。
OIDC_ISSUER_URL=
# OIDC Audience；填登录后 Access Token 的 aud 值。
OIDC_AUDIENCE=
# OIDC Client ID；填身份平台为 Backend/API 注册的客户端 ID。
OIDC_CLIENT_ID=
# OIDC Client Secret；填上述 Backend/API 客户端在身份平台生成的真实密钥。
OIDC_CLIENT_SECRET=
# OIDC Discovery/JWKS 超时、缓存和允许的非对称签名算法。
OIDC_DISCOVERY_TIMEOUT_SECONDS=10
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_CLEARANCE_CLAIM=clearance_level
# 当前 Production 部署绑定的租户与默认知识空间 ID；tenant 必须匹配 Token claim，space 是该租户的知识空间 ID。
OIDC_TENANT_ID=
OIDC_DEFAULT_SPACE_ID=

# ==================== 日志与运行监控 ====================
# 日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
# 本地日志文件目录。
LOG_DIR=./data/storage/logs
# 单个日志文件最大大小，单位 MB。
LOG_MAX_FILE_SIZE_MB=50
# 日志文件保留天数。
LOG_RETENTION_DAYS=30
# 是否启用 OpenTelemetry Trace；本地未配置 Collector 时可 false。
OTEL_ENABLED=false
# OpenTelemetry Collector Endpoint；OTEL_ENABLED=true 时填写。
OTEL_EXPORTER_OTLP_ENDPOINT=
