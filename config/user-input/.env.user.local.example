# 仅作字段说明。复制为 .env.user.local 后填写真实值。
# 不启用的服务不要伪造密钥；真实值不要提交、截图或粘贴到聊天中。

# 使用真实 MySQL 时填写；SQLite 本地适配器不使用。
MYSQL_PASSWORD=

# 使用需要认证的 Milvus 服务时填写；本地文件适配器不使用。
MILVUS_TOKEN=

# 使用真实 RabbitMQ/Redis 时填写；Python 本地适配器不使用。
RABBITMQ_URL=
REDIS_URL=

# 使用企业 OIDC/Keycloak 时填写；local_dev 身份不使用。
OIDC_CLIENT_SECRET=

# 只填写实际选择并启用的 AI 服务。
MINERU_TOKEN=
LLM_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=
OCR_API_KEY=
ASR_API_KEY=
